<mod name="BotsHaveFeelingsReborn" image="icon.png"
      description="Some slight improvements for the team AI."
      author="Takku, BangL"
      contact="https://steamcommunity.com/id/BangL"
      version="0.14.1"
      priority="-1"
	min_sblt_version="2.1.0"
      color="60 60 60">
      <updates>
            <update identifier="botshavefeelingsreborn">
                <host meta="https://raw.githubusercontent.com/BangL/raid-mods-meta/main/botshavefeelingsreborn.json"/>
            </update>
      </updates>
      <localization directory="loc">
            <loc file="english.json"
                  language="english" />
            <loc file="german.json"
                  language="german" />
      </localization>
      <assets base_path="assets/">
            <group name="effects/bhfr/">
                  <file :name="pee_stream.effect" />
            </group>
      </assets>
      <hooks>
            <pre hook_id="lib/entry"
                  script_path="BotsHaveFeelingsReborn.lua" />
